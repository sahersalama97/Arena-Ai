              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "id": "if1",
      "name": "Has new brands?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const brands = items.map(i => i.json.Brand_Name + ' (act_' + i.json.Meta_Ad_Account_ID + ')');\nconst text = 'New Meta ad account(s) discovered and added to the Brand Registry as needs_setup:\\n\\n' + brands.join('\\n') + '\\n\\nTo activate: open the Brand Registry, fill in Report_Email (and TikTok_Advertiser_ID if this brand also runs TikTok), then set Status to \"active\". Nothing will sync or report for this brand until that happens.';\nreturn [{json:{subject: 'New brand(s) need setup: ' + brands.length, text}}];"
      },
