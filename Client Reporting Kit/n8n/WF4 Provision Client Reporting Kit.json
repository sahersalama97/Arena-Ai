      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "name": "Daily 10:30",
      "position": [
        -1900,
        520
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1ytFhXwRpANDR5HB1NnKFcmeQspVZ-Ves3h03dsFq4xU"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "name": "Read Brand Registry",
      "position": [
        -1660,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SBl4DBB9PIqzy5w0",
          "name": "Ai Saher Google Sheets"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Only brands that are active, already have a Raw sheet to read from, and do\n// not yet have a dashboard. Re-running is therefore safe: it creates the\n// missing ones and leaves existing dashboards -- and any edits a human made to\n// their Benchmarks or business inputs -- completely alone.\nreturn items.filter(i => {\n  const j = i.json || {};\n  return (j.Status || '').toLowerCase() === 'active' && j.Raw_Sheet_ID && !j.Kit_Sheet_ID;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Filter brands needing a kit",
      "position": [
        -1420,
        400
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "name": "Loop brands",
      "position": [
        -1180,
        400
      ]
    },
    {
      "parameters": {
        "operation": "copy",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "1TQax9tFM_cFk8c15Mt60xPcJj3TGqh0ZSP68i1Z6dX4"
        },
        "name": "={{ $json.Brand_Name }} - Reporting Dashboard (LIVE)",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "name": "Copy kit template",
      "position": [
        -940,
        400
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "5KJlnp3mTAKGBAdb",
          "name": "Ai Saher Google Drive"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1ytFhXwRpANDR5HB1NnKFcmeQspVZ-Ves3h03dsFq4xU"
        },
