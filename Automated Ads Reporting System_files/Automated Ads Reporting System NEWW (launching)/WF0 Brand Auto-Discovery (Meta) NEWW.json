    },
    {
      "parameters": {
        "jsCode": "const out=[];\nfor(const item of items){\n  const rows=item.json?.data||[];\n  for(const r of rows){\n    if(r.account_status===1||r.account_status==null){ // 1 = ACTIVE in Meta's enum; keep active accounts\n      out.push({json:{Meta_Ad_Account_ID:String(r.account_id||r.id).replace(/^act_/,''), Brand_Name:r.name}});\n    }\n  }\n}\nreturn out;"
      },
