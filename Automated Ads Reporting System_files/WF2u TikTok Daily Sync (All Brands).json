    {
      "parameters": {
        "jsCode": "const METRIC_MAP={ad_name:'ad_name',campaign_name:'campaign_name',adgroup_name:'adgroup_name',spend:'spend',impressions:'impressions',reach:'reach',cpm:'cpm',clicks:'clicks',ctr:'ctr',profile_visits:'profile_visits',follows:'follows',atc:'onsite_shopping_add_to_cart',ic:'onsite_shopping_initiate_checkout_count',purchases:'onsite_shopping_purchase',purchases_value:'onsite_shopping_purchase_value'};\nfunction num(v){if(v==null||v==='')return 0;const n=Number(v);return Number.isFinite(n)?n:0;}\nfunction round(n,p){const f=10**p;return Math.round(n*f)/f;}\nfunction creativeKey(adName){if(!adName)return '';let k=String(adName).toLowerCase();k=k.replace(/^\\s*(vid|pic|video|image)\\s*-\\s*/,'');return k.trim();}\nconst out=[];\nfor(const item of items){\n  const j=item.json;\n  if(j&&j.code&&j.code!==0){out.push({json:{error:j.message||('TikTok API error code '+j.code)}});continue;}\n  const rows=j?.data?.list||[];\n  for(const row of rows){\n    const m=row.metrics||{};\n    const d=row.dimensions||{};\n    const spend=num(m[METRIC_MAP.spend]),impressions=num(m[METRIC_MAP.impressions]),purchases=num(m[METRIC_MAP.purchases]),purchasesValue=num(m[METRIC_MAP.purchases_value]),clicks=num(m[METRIC_MAP.clicks]);\n    out.push({json:{\n      Date:d.stat_time_day? String(d.stat_time_day).slice(0,10):'',\n      Ad_ID:d.ad_id||'',\n      Ad_Name:m[METRIC_MAP.ad_name]||'',\n      Campaign_Name:m[METRIC_MAP.campaign_name]||'',\n      AdGroup_Name:m[METRIC_MAP.adgroup_name]||'',\n      Creative_Key:creativeKey(m[METRIC_MAP.ad_name]),\n      Spend:round(spend,2),\n      Impressions:impressions,\n      Reach:num(m[METRIC_MAP.reach]),\n      CPM:round(num(m[METRIC_MAP.cpm]),2),\n      Clicks:clicks,\n      CTR_Pct:round(num(m[METRIC_MAP.ctr]),4),\n      Profile_Visits:num(m[METRIC_MAP.profile_visits]),\n      Follows:num(m[METRIC_MAP.follows]),\n      Adds_to_Cart:num(m[METRIC_MAP.atc]),\n      Initiate_Checkout:num(m[METRIC_MAP.ic]),\n      Purchases:purchases,\n      Purchases_Value:round(purchasesValue,2),\n      ROAS:round(spend?purchasesValue/spend:0,4),\n      AOV:round(purchases?purchasesValue/purchases:0,2),\n      Purchase_CVR_Pct:round(clicks?(purchases/clicks)*100:0,4),\n      Pulled_At:new Date().toISOString()\n    }});\n  }\n}\nif(!out.length)return[{json:{error:'No TikTok ad-level rows returned'}}];\nreturn out;"
