    {
      "parameters": {
        "url": "https://graph.facebook.com/v21.0/me/adaccounts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,account_status"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {
          "pagination": {}
        }
      },
      "alwaysOutputData": true,
      "id": "http1",
      "maxTries": 3,
      "name": "List Meta Ad Accounts",
      "position": [
        80,
        112
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qQUVSfCeWtFUWkkM",
          "name": "Meta-Access Tokens"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Requires a System User token with access to every ad account (Business Manager > System Users > assign all ad accounts, or use a Business Manager owned-accounts token). Lists ALL ad accounts the token can see — each one becomes a 'brand' candidate."
    },
    {
      "parameters": {
        "jsCode": "const out=[];\nfor(const item of items){\n  const rows=item.json?.data||[];\n  for(const r of rows){\n    if(r.account_status===1||r.account_status==null){ // 1 = ACTIVE in Meta's enum; keep active accounts\n      out.push({json:{Meta_Ad_Account_ID:r.id, Brand_Name:r.name}});\n    }\n  }\n}\nreturn out;"
      },
      "id": "code1",
      "name": "Flatten accounts",
      "position": [
        320,
        112
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1ytFhXwRpANDR5HB1NnKFcmeQspVZ-Ves3h03dsFq4xU"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "gs1",
      "name": "Read Brand Registry",
      "position": [
        560,
        112
      ],
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "rqsBKtQ08F7jiPT4",
          "name": "Google Sheets account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const existing=new Set($('Read Brand Registry').all().map(i=>i.json.Meta_Ad_Account_ID).filter(Boolean));\nconst candidates=$('Flatten accounts').all().map(i=>i.json);\nconst now=$now.toISO();\nconst out=candidates.filter(c=>!existing.has(c.Meta_Ad_Account_ID)).map(c=>({json:{\n  Brand_Name:c.Brand_Name,\n  Platform:'meta',\n  Meta_Ad_Account_ID:c.Meta_Ad_Account_ID,\n  TikTok_Advertiser_ID:'',\n  Report_Email:'PASTE_YOUR_EMAIL@example.com',\n  Raw_Sheet_ID:'',\n  Current_Month_Report_Sheet_ID:'',\n  Status:'needs_setup',\n  Discovered_At:now\n}}));\nreturn out.length? out : [{json:{__noNewBrands:true}}];"
      },
      "id": "code2",
      "name": "Diff new brands",
      "position": [
        800,
        112
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1ytFhXwRpANDR5HB1NnKFcmeQspVZ-Ves3h03dsFq4xU"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "mappingMode": "autoMapInputData",
          "matchingColumns": [
            "Meta_Ad_Account_ID"
          ],
          "schema": [],
          "value": {}
        },
        "options": {}
      },
      "id": "gs2",
      "name": "Append new brands",
      "position": [
        1040,
        112
      ],
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "rqsBKtQ08F7jiPT4",
          "name": "Google Sheets account"
        }
      },
      "notes": "New brands land with Status=needs_setup so they don't get synced/reported until you fill TikTok_Advertiser_ID + Report_Email and flip Status to 'active'. This is intentional — avoids silently syncing/reporting on a brand before it's fully configured."
    },
