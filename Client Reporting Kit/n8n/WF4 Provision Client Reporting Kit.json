      "alwaysOutputData": true
    },
    {
      "parameters": {
        "fromEmail": "sahersalama97@gmail.com",
        "toEmail": "sahersalama97@gmail.com",
        "subject": "=Kit provisioning: registry not updated - {{ $('Loop brands').item.json.Brand_Name }}",
        "options": {
          "appendAttribution": false
