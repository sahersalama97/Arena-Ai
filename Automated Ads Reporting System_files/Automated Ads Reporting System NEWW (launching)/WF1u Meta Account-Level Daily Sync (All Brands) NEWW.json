    {
      "parameters": {
        "jsCode": "// First 8 days of a month: re-pull the whole previous month so late conversions\n// (7-day click attribution) are final. After that: month-to-date.\nconst until = $today.minus({ days: 1 });\nconst monthStart = $today.startOf('month');\nconst since = $today.day <= 8 ? monthStart.minus({ months: 1 }) : monthStart;\nreturn [{ json: { since: since.toISODate(), until: until.toISODate(), time_range: JSON.stringify({ since: since.toISODate(), until: until.toISODate() }) } }];"
      },
      "id": "4a4d0500-c0eb-4d25-8050-da32faaf64ab",
      "name": "Date window (current month)",
      "position": [
        -3136,
        720
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "notes": "Days 1-8 of a month: previous month 1st through yesterday (final re-pull). Day 9 onward: current month 1st through yesterday."
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/act_{{ $('Loop brands').item.json.Meta_Ad_Account_ID.toString().replace(/^act_/,'') }}/insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "spend,impressions,reach,frequency,cpm,unique_outbound_clicks,unique_outbound_clicks_ctr,outbound_clicks,actions,action_values,date_start,date_stop"
            },
            {
              "name": "level",
              "value": "account"
            },
            {
              "name": "time_increment",
              "value": "1"
            },
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "use_unified_attribution_setting",
              "value": "true"
            },
            {
              "name": "time_range",
              "value": "={{ $json.time_range }}"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "11a11113-b170-484f-9b84-4d3b96dda8a5",
      "maxTries": 3,
      "name": "Meta Insights yesterday",
      "position": [
        -2896,
        720
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qQUVSfCeWtFUWkkM",
          "name": "Meta-Access Tokens"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Uses Meta ad set/unified attribution setting so purchase/action totals align more closely with Ads Manager columns."
    },
    {
      "parameters": {
        "jsCode": "const CONFIG={purchase:['offsite_conversion.fb_pixel_purchase','omni_purchase','purchase'],purchase_value:['offsite_conversion.fb_pixel_purchase','omni_purchase','purchase'],atc:['offsite_conversion.fb_pixel_add_to_cart','omni_add_to_cart','add_to_cart'],ic:['offsite_conversion.fb_pixel_initiate_checkout','omni_initiated_checkout','initiate_checkout']};\nfunction num(v){if(v==null||v==='')return 0;const n=Number(v);return Number.isFinite(n)?n:0;}\nfunction actionSum(arr,types){if(!Array.isArray(arr))return 0;let t=0;for(const a of arr){if(types.includes(a.action_type))t+=num(a.value);}return t;}\nfunction pickType(arr,prio){if(!Array.isArray(arr))return null;for(const t of prio){if(arr.some(a=>a.action_type===t))return t;}return null;}\nfunction pickSum(arr,prio){const t=pickType(arr,prio);return t?actionSum(arr,[t]):0;}\nfunction outboundClicks(d){if(Array.isArray(d.outbound_clicks))return actionSum(d.outbound_clicks,['outbound_click']);return num(d.outbound_clicks);}\nfunction outboundCtr(d,clicks,imps){return imps?(clicks/imps)*100:0;}\nfunction round(n,p){const f=10**p;return Math.round(n*f)/f;}\nfunction flattenOne(d){const spend=num(d.spend),impressions=num(d.impressions),reach=num(d.reach);const frequency=num(d.frequency)||(reach?impressions/reach:0);const cpm=num(d.cpm)||(impressions?(spend/impressions)*1000:0);const clicks=outboundClicks(d);const ctr=outboundCtr(d,clicks,impressions);const atc=pickSum(d.actions,CONFIG.atc);const ic=pickSum(d.actions,CONFIG.ic);const pType=pickType(d.actions,CONFIG.purchase);const purchases=pType?actionSum(d.actions,[pType]):0;const purchasesValue=(pType&&pickType(d.action_values,[pType]))?actionSum(d.action_values,[pType]):pickSum(d.action_values,CONFIG.purchase_value);const roas=spend?purchasesValue/spend:0;const aov=purchases?purchasesValue/purchases:0;const cvr=clicks?(purchases/clicks)*100:0;return{Date:d.date_start||d.date_stop||'',Spend:round(spend,2),Impressions:impressions,Reach:reach,Frequency:round(frequency,2),CPM:round(cpm,2),Clicks:clicks,CTR_Pct:round(ctr,4),Adds_to_Cart:atc,Initiate_Checkout:ic,Purchases:purchases,Purchases_Value:round(purchasesValue,2),ROAS:round(roas,4),AOV:round(aov,2),Purchase_CVR_Pct:round(cvr,4),Pulled_At:new Date().toISOString()};}\nconst out=[];for(const item of items){const j=item.json;if(j&&j.error){out.push({json:{error:JSON.stringify(j.error)}});continue;}const rows=Array.isArray(j.data)?j.data:[];for(const row of rows){if(!row||(row.spend==null&&row.impressions==null&&!row.date_start))continue;out.push({json:flattenOne(row)});}}\nif(!out.length)return[{json:{error:'No insights rows returned'}}];\nreturn out;"
      },
