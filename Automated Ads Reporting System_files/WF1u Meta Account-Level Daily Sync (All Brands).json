    {
      "parameters": {
        "jsCode": "const CONFIG={purchase:['purchase','omni_purchase'],purchase_value:['purchase','omni_purchase'],atc:['add_to_cart','omni_add_to_cart'],ic:['initiate_checkout','omni_initiated_checkout']};\nfunction num(v){if(v==null||v==='')return 0;const n=Number(v);return Number.isFinite(n)?n:0;}\nfunction actionSum(arr,types){if(!Array.isArray(arr))return 0;let t=0;for(const a of arr){if(types.includes(a.action_type))t+=num(a.value);}return t;}\nfunction outboundClicks(d){if(Array.isArray(d.unique_outbound_clicks))return actionSum(d.unique_outbound_clicks,['outbound_click']);return num(d.unique_outbound_clicks);}\nfunction outboundCtr(d,clicks,imps){if(Array.isArray(d.unique_outbound_clicks_ctr)){const hit=d.unique_outbound_clicks_ctr.find(x=>x.action_type==='outbound_click');return hit?num(hit.value):0;}if(d.unique_outbound_clicks_ctr!=null&&d.unique_outbound_clicks_ctr!=='')return num(d.unique_outbound_clicks_ctr);return imps?(clicks/imps)*100:0;}\nfunction round(n,p){const f=10**p;return Math.round(n*f)/f;}\nfunction flattenOne(d){const spend=num(d.spend),impressions=num(d.impressions),reach=num(d.reach);const frequency=num(d.frequency)||(reach?impressions/reach:0);const cpm=num(d.cpm)||(impressions?(spend/impressions)*1000:0);const clicks=outboundClicks(d);const ctr=outboundCtr(d,clicks,impressions);const atc=actionSum(d.actions,CONFIG.atc);const ic=actionSum(d.actions,CONFIG.ic);const purchases=actionSum(d.actions,CONFIG.purchase);const purchasesValue=actionSum(d.action_values,CONFIG.purchase_value);const roas=spend?purchasesValue/spend:0;const aov=purchases?purchasesValue/purchases:0;const cvr=clicks?(purchases/clicks)*100:0;return{Date:d.date_start||d.date_stop||'',Spend:round(spend,2),Impressions:impressions,Reach:reach,Frequency:round(frequency,2),CPM:round(cpm,2),Clicks:clicks,CTR_Pct:round(ctr,4),Adds_to_Cart:atc,Initiate_Checkout:ic,Purchases:purchases,Purchases_Value:round(purchasesValue,2),ROAS:round(roas,4),AOV:round(aov,2),Purchase_CVR_Pct:round(cvr,4),Pulled_At:new Date().toISOString()};}\nconst out=[];for(const item of items){const j=item.json;if(j&&j.error){out.push({json:{error:JSON.stringify(j.error)}});continue;}const rows=Array.isArray(j.data)?j.data:[];for(const row of rows){if(!row||(row.spend==null&&row.impressions==null&&!row.date_start))continue;out.push({json:flattenOne(row)});}}\nif(!out.length)return[{json:{error:'No insights rows returned'}}];\nreturn out;"
